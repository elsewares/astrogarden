		<div>
			<h3>{title}</h3>
			<p class="description">{description}</p>
			<div class="metadata-container">
				<span>Project</span>
				<svg width="4px" height="6px">
					<circle r="2" cx="2" cy="2" fill="var(--color-crimson)"></circle>
				</svg>
				<RelativeDate postDate={date} />
			</div>
		</div>
