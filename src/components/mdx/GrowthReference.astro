---
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip.astro";
interface Props {
  position?: "left" | "center" | "right";
}

const { position } = Astro.props;
---

<div class='growth-reference mobile-only'>
  <div class="item taxonomy">
    <span>Taxonomic Reference</span>
  </div>
  <br class="mobile-only" />
  <Tooltip>
    <div class="item">
      <Icon name="spore" width="24" />
      <span>Spore</span>
    </div>
    <div slot="content">
      <p>An initial idea or random thought that starts the growth process.</p>
    </div>
  </Tooltip>
  <div class="separator"></div>
  <Tooltip>
    <div class="item">
      <Icon name="hyphae" width="24" />
      <span>Hyphae</span>
    </div>
    <div slot="content">
      <p>An idea thread that joins two or more others - connective tissue.</p>
    </div>
  </Tooltip>
  <div class="separator"></div>
  <Tooltip>
    <div class="item">
      <Icon name="soma" width="24" />
      <span>Soma</span>
    </div>
    <div slot="content">
      <p>Work that has matured enough to be considered its own thing.</p>
    </div>
  </Tooltip>
  <div class="separator"></div>
  <Tooltip>
    <div class="item">
      <Icon name="colony" width="24" />
      <span>Colony</span>
    </div>
    <div slot="content">
      <p>A completed piece, ready for export to the wider web in one form or another.</p>
    </div>
  </Tooltip>
</div>

<style>
  .growth-reference {
    display: flex;
    align-items: center;
    justify-content: left;
    gap: 1rem;
    height: 40px;
    margin: 0 auto;
  }

  .growth-reference .item span {
    font-family: var(--font-sans), sans-serif;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .separator {
    width: 1px;
    height: 20px;
    background-color: var(--color-caving, #666);
  }

  .taxonomy {
    font-weight: 600;
    color: var(--color-pelagic);
    font-size: var(--font-size-sm);
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 768px) {
    .growth-reference {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .item {
      justify-content: center;
    }
    .separator {
      display: none;
    }
    .mobile-only {
      display: block;
    }
  }
</style>
