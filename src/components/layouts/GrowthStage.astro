---
import Tooltip from "../mdx/Tooltip.astro";

interface Props {
	stage: "spore" | "hyphae" | "soma" | "colony";
}

const { stage } = Astro.props;

const tooltipContent = {
	colony:
		"Colonies are ideas that are fully formed and have been shared with the world. They represent a fusion of at least two different areas of thought. They are the most mature and developed.",
	spore:
		"Spores are ideas that are still in the early stages of development. They are not yet fully formed and need time to fester.",
	hyphae:
		"Hyphae documents are ideas that are in the process of being developed. They are not yet fully formed, but they are more developed than spores. They are like the roots of a fungus, spreading out and connecting with other ideas.",
	soma:
		"Soma documents are ideas that have been fully fleshed out. They are the most polished and refined.",
};
---

<Tooltip maxWidth={300}>
	<p class="growth-stage">{stage}</p>
	<p slot="content">{tooltipContent[stage]}</p>
</Tooltip>

<style>
	.growth-stage {
		display: inline-block;
		cursor: pointer;
		font-family: var(--font-sans), sans-serif;
		font-size: var(--font-size-xs);
		color: var(--color-gray-800);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: bold;
		padding-right: var(--space-xs);
	}
</style>
