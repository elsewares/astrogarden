---
import { Icon } from "astro-icon/components";

interface Props {
	growthStage: "spore" | "hyphae" | "soma" | "colony";
	size?: string;
}

const { growthStage, size = "22" } = Astro.props;
---

{
	growthStage === "spore" && (
		<Icon name="spore" width={size} height={size} style="flex-shrink: 0;" />
	)
}
{
	growthStage === "hyphae" && (
		<Icon name="hyphae" width={size} height={size} style="flex-shrink: 0;" />
	)
}
{
	growthStage === "soma" && (
		<Icon name="soma" width={size} height={size} style="flex-shrink: 0;" />
	)
}
{
	growthStage === "colony" && (
	<Icon name="colony" width={size} height={size} style="flex-shrink: 0;" />
		)
	}
