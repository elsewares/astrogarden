---
import Footer from "../components/layouts/Footer.astro";
import Navbar from "../components/layouts/navbar/Navbar.astro";
import GoogleTags from "../components/layouts/GoogleTags.astro";
import { ClientRouter } from 'astro:transitions';

import { SEO } from "astro-seo";
import "../global.css";

export interface Props {
	title?: string;
	desc?: string;
	type?: string;
	coverImage?: string;
}

const { title, desc, type, coverImage } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Generate OG image URL
const currentPath = Astro.url.pathname;
const contentId = currentPath.split("/").filter(Boolean).join("/");

// Use localhost URL in development, production URL otherwise
const baseUrl = import.meta.env.DEV ? "http://localhost:4321" : Astro.site;

// Construct OG image URL - now just using the content ID directly
const ogImageURL = type
	? new URL(`/og/${contentId}.png`, baseUrl)
	: new URL(`/og.png`, baseUrl);

// Only add search params for non-content pages (like the homepage)
if (!type) {
	if (title) ogImageURL.searchParams.set("title", title);
	if (desc) ogImageURL.searchParams.set("description", desc);
	if (coverImage) ogImageURL.searchParams.set("coverImage", coverImage);
}

// Google Analytics type declarations
declare global {
	interface Window {
		dataLayer: any[];
		gtag: (...args: any[]) => void;
	}
}
---
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/images/elsewares-logo.svg"
		/>
		<link
			rel="icon"
			type="image/svg"
			sizes="32x32"
			href="/images/elsewares-logo.svg"
		/>
		<link
			rel="icon"
			type="image/svg"
			sizes="16x16"
			href="/images/elsewares-logo.svg"
		/>
		<link rel="manifest" href="/manifest.json" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="anastamosis RSS Feed"
			href="/rss.xml"
		/>
		<link
			rel="webmention"
			href="https://webmention.io/anastamosis.io/webmention"
		/>

		<link
			rel="pingback"
			href="https://webmention.io/anastamosis.io/xmlrpc"
		/>
		<link rel="me" href="https://github.com/elsewares" />
		<link rel="canonical" href={canonicalURL} />
		<SEO
			title={title}
			description={desc ||
				"A collection of disparate threads of thought from the brain behind elsewares.io"}
			canonical={canonicalURL}
			openGraph={{
				basic: {
					type: "website",
					url: canonicalURL,
					title: title || "anastamosis.io",
					image: ogImageURL.toString(),
				},
				optional: {
					locale: "en_GB",
					description:
						desc ||
						"A collection of disparate threads of thought from the brains behind elsewares.io",
				},
				image: {
					alt: title || "anastamosis.io",
					width: 1200,
					height: 630,
				},
			}}
		/>
		<GoogleTags />
		<ClientRouter />
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			img {
				content-visibility: auto;
			}
		</style>
		<script async src="https://platform.twitter.com/widgets.js"></script>
		</body>
</html>
