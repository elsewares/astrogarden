{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@images/covers/*": ["/src/images/covers/*"],
      "@images/posts": ["/src/images/posts/*"],
      "@components/*": ["/src/components/*"],
      "@content/*": ["/src/content/*"],
      "@layouts/*": ["/src/layouts/*"],
      "@icons/*": ["/src/icons/*"],
      "@pages/*": ["/src/pages/*"]
    }
  }
}
